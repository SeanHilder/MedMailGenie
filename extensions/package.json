{
  "name": "medmailgenie",
  "version": "1.0.0",
  "type": "module",
  "description": "intelligent email assistant for medical professionals",
  "scripts": {
    "build": "npm run type-check && vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeanHilder/MedMailGenie.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SeanHilder/MedMailGenie/issues"
  },
  "homepage": "https://github.com/SeanHilder/MedMailGenie#readme",
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "jsdom": "^29.1.1",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
